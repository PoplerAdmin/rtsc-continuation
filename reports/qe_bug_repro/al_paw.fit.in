&control
 calculation='scf', prefix='t', outdir='./tmp/', pseudo_dir='SSSP_DIR'
/
&system
 ibrav=2, celldm(1)=7.65, nat=1, ntyp=1, ecutwfc=30, ecutrho=240,
 occupations='smearing', smearing='mv', degauss=0.02, la2F=.true.
/
&electrons
 conv_thr=1e-10
/
ATOMIC_SPECIES
 Al 26.98 Al.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
 Al 0.0 0.0 0.0
K_POINTS automatic
 16 16 16 0 0 0
