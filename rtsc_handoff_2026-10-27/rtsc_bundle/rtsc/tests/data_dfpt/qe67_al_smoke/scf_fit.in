 &control
    calculation = 'scf'
    prefix = 'al'
    outdir = './tmp/'
    pseudo_dir = '/usr/share/espresso/pseudo/'
    tprnfor = .true.
    tstress = .true.
    verbosity = 'high'
 /
 &system
    ibrav = 0
    nat = 1
    ntyp = 1
    ecutwfc = 15.0
    occupations = 'smearing'
    smearing = 'mv'
    degauss = 0.05
    la2F = .true.
 /
 &electrons
    conv_thr = 1.0d-9
    mixing_beta = 0.5
 /
